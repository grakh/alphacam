N[N] %
N[N] M30
$----------------------- File TRAILING Lines ----------------------------------------
$17 File TRAILING Lines
$----------------------- RAPID MOVES ----------------------------------------
$20 Rapid Move in XY (MILL/ROUTER/FLAME/LASER) or XZ (LATHE) only
$MODAL ON
$LET STRECKE_NUTZEN = 0
$IF MC = 1
$LET TRCRAP = 33
$LET COMP1 = TC
$ELSE
$LET TRCRAP = 0
$LET COMP1 = ""
$ENDIF
$LET MITTE = 0
$LET BAHNMITTE = 0
$LET OFFEN = 0
$LET TRC = 0
$IF L_R = 0
$LET MITTE = 1100
$ENDIF
$IF I_O = 0
$LET BAHNMITTE = 2100
$ELSEIF I_O = -2
$LET OFFEN = 3001
$ENDIF
$IF OUT = 1
$LET OUTNC = 5100
$ENDIF
$LET SPEED = [S]
$IF SPEED < 15000
$LET SPEED = SPEED * 100
$ELSEIF SPEED > 100000
$LET SPEED = 100000
$ENDIF
$IF SPINDLE_ON = 0
N[N] M3 K[SPEED]
$LET SPINDLE_ON = 1
$ENDIF
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
$LET XAPO=AX
$LET YAPO=AY
$----------------------- RAPID MOVE in XYZ ----------------------------------
$21 3D Rapid Move in XYZ (MILL/ROUTER ONLY)
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
$LET XAPO=AX
$LET YAPO=AY
N[N] G0 X[AX] Y[AY] Z[AZ] F500
$----------------------- RAPID MOVE in Z ------------------------------------
$25 Rapid Move in Z only (MILL etc)
$IF NO_Z = 1
$LET NO_Z = 0
$ELSEIF NO_Z = 0
N[N] G0 Z[AZ] F500
$LET HIDE = 1
$IF TRCRAP + FRA = 34
N[N] G1 [TC] X[AX] Y[AY] F[FC/ 60.0]
$ELSEIF TRC+FRA+OUTNC+OUTCIR = 9106
N[N] G1 [TC] X[AX] Y[AY] F[FC/ 60.0]
$ELSEIF TRC+FRA+OUTNC+OUTCIR = 4005
N[N] [TC]
N[N] G1 X[AX] Y[AY] F[FC/ 60.0]
$ENDIF
$ENDIF
$IF FRA = 1
N[N] %PATH [STRECKE_NUTZEN] MM
$ENDIF
$IF FRA + SHAPE_OPEN = 2
N[N] G0 F500
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
$LET OUTNC = 0
$LET OUTCIR = 0
