N[N] %M987  % Ext. chip suction unit OFF
N[N] %M992  % Shutter milling spindle CLOSE
N[N] %M978  % Control Vacuum OFF
N[N] %
N[N] %***** END OF PROGRAM ******************************
N[N] %
'';;N[N] (MSG, [FNM] END) 
N[N] M30
