$--POSTPROCESSOR https://hansmill.ru  DCM engraving machine, controller HCFA HCQ9P-1700
$--CHANGES: 2026-10-15 V1_20 No subroutines and no TRS origin shift: code output in full
$--CHANGES: 2026-10-15 V1_19 Separators and template text removed, comments translated to English
$--CHANGES: 2026-10-15 V1_18 M978 (vacuum OFF) removed at program end
$--CHANGES: 2026-10-15 V1_17 Each drilled hole in its own %SHAPE block
$--CHANGES: 2026-10-15 V1_16 Drill cycles $200-$215 fixed (F5000 removed, retract before XY, rapid to ZR)
$--CHANGES: 2026-10-15 V1_15 AEC/MTX code removed (MicroPerf, DryRun, DLA/SCLN, measuring cycle, prompts), ; lines in $220-$245 removed
$--CHANGES: 2026-10-15 V1_14 Cleanup: commented-out AEC code and comments removed
$--CHANGES: 2026-10-15 V1_13 Path length as one line %PATH ... MM
$--CHANGES: 2026-10-15 V1_12 Comments with % instead of ;, %SHAPE markers with line number
$--CHANGES: 2026-10-15 V1_11 Label .SHAPE[LOOP] and IHOC height measurement disabled
$--CHANGES: 2026-10-06 V1_10 $50/$60: FF + BAHNMITTE = 2101 (was = 2, never true)
$--CHANGES: 2026-10-06 V1_9 XAPO/YAPO stored in $21
$--CHANGES: 2026-10-06 V1_8 Debug comments at line end removed
$--CHANGES: 2026-10-06 V1_7 G2/G3 in $50/$60 fixed, OUTCIR in 50,16, stray $ENDIF in $100, comment in $210
$--CHANGES: 2026-10-06 V1_6 M988/M991/M979/M996 at start, M987/M992/M978 at end enabled
$--CHANGES: 2026-10-06 V1_5 G0 with F500 (500 mm/s)
$--CHANGES: 2026-10-06 V1_4 IHOC label moved out of contours, GOTO .PART in $50/$60 disabled
$--CHANGES: 2026-10-06 V1_3 Contour markers %SHAPE n BEGIN / END
$--CHANGES: 2026-10-06 V1_2 M3 only once at program start
$--CHANGES: 2025-12-05 V1_1 Initial version
$5 Call external program
$10 File LEADING lines
$LET STRECKE_NUTZEN = 0
$LET NO_Z = 1
$LET SPEED = 0
$LET SPINDLE_ON = 0
$LET SHAPE_NR = 0
$LET SHAPE_OPEN = 0
$LET HIDE = 0
$LET TRCRAP = 0
$LET OUTNC = 0
$LET OUTCIR = 0
$12 Main Program LEADING lines
N[N] %****************************************************
N[N] %** https://hansmill.ru                            **
N[N] %** DCM High Speed Engraving Machine               **
N[N] %** NC-Program created on: [DAT]       **
N[N] %****************************************************
N[N] %
N[N] %***** Presettings *********************************
N[N] %
N[N] G17
N[N] G90 F50
N[N] G53
N[N] G0 Z53 F500
N[N] %*********************************************************
N[N] M988 % Ext. Chip Suction Unit ON
N[N] M991 % Shutter Milling Spindle OPEN
N[N] M979 % Control Vacuum ON
N[N] M996 % Tool Cover DOWN
N[N] %***************************************************
$15 Main Program TRAILING lines
$IF SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
N[N] %
N[N] %***** Postsettings ********************************
N[N] %
N[N] G53
N[N] G0 Z53 F500
N[N] % X785 Y600
N[N] M987  % Ext. chip suction unit OFF
N[N] M992  % Shutter milling spindle CLOSE
N[N] %
N[N] %***** END OF PROGRAM ******************************
N[N] %
N[N] M30
$17 File TRAILING Lines
$20 Rapid Move in XY (MILL/ROUTER/FLAME/LASER) or XZ (LATHE) only
$MODAL ON
$LET STRECKE_NUTZEN = 0
$IF MC = 1
$LET TRCRAP = 33
$LET COMP1 = TC
$ELSE
$LET TRCRAP = 0
$LET COMP1 = ""
$ENDIF
$LET MITTE = 0
$LET BAHNMITTE = 0
$LET OFFEN = 0
$LET TRC = 0
$IF L_R = 0
$LET MITTE = 1100
$ENDIF
$IF I_O = 0
$LET BAHNMITTE = 2100
$ELSEIF I_O = -2
$LET OFFEN = 3001
$ENDIF
$IF OUT = 1
$LET OUTNC = 5100
$ENDIF
$LET SPEED = [S]
$IF SPEED < 15000
$LET SPEED = SPEED * 100
$ELSEIF SPEED > 100000
$LET SPEED = 100000
$ENDIF
$IF SPINDLE_ON = 0
N[N] M3 K[SPEED]
$LET SPINDLE_ON = 1
$ENDIF
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
$LET XAPO=AX
$LET YAPO=AY
$21 3D Rapid Move in XYZ (MILL/ROUTER ONLY)
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
$LET XAPO=AX
$LET YAPO=AY
N[N] G0 X[AX] Y[AY] Z[AZ] F500
$25 Rapid Move in Z only (MILL etc)
$IF NO_Z = 1
$LET NO_Z = 0
$ELSEIF NO_Z = 0
N[N] G0 Z[AZ] F500
$LET HIDE = 1
$IF TRCRAP + FRA = 34
N[N] G1 [TC] X[AX] Y[AY] F[FC/ 60.0]
$ELSEIF TRC+FRA+OUTNC+OUTCIR = 9106
N[N] G1 [TC] X[AX] Y[AY] F[FC/ 60.0]
$ELSEIF TRC+FRA+OUTNC+OUTCIR = 4005
N[N] [TC]
N[N] G1 X[AX] Y[AY] F[FC/ 60.0]
$ENDIF
$ENDIF
$IF FRA = 1
N[N] %PATH [STRECKE_NUTZEN] MM
$ENDIF
$IF FRA + SHAPE_OPEN = 2
N[N] G0 F500
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
$LET OUTNC = 0
$LET OUTCIR = 0
$30 Lines BEFORE a rapid move if Z levels are not used eg Laser or Geometry
$35 Lines AFTER a rapid move if Z levels are not used eg Laser or Geometry
$40  Machining FEED lines
$MODAL ON
$LET STRECKE_NUTZEN = STRECKE_NUTZEN + SQR(IX**2 + IY**2 + IZ**2)
$IF MC = 1
$LET TRC = 4004
$ELSE
$LET TRC = 0
$ENDIF
$IF OUT = 1
$LET OUTNC = 5100
$ENDIF
$IF FF + TRCRAP = 34
N[N] G0 [COMP1] X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ELSEIF FF + MITTE = 1101
N[N] G0 X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
N[N] G1 X[AX] Y[AY] F[F/ 60.0]
$ELSEIF FF + TRCRAP + TRC + IN = 4005
N[N] G0 [TC] X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ELSEIF FF + TRC = 4005
N[N] G0 X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
N[N] [TC]
N[N] G1 X[AX] Y[AY] F[F/ 60.0]
$ELSEIF FF + TRCRAP + TRC = 1
N[N] G0 X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ENDIF
$IF TRC + IN + TRCRAP = 34
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ELSEIF TRC + IN + FF = 4005
N[N] G1 X[AX] Y[AY] Z[AZ] F[F/ 60.0]
$ELSEIF FF + MOT = 11
N[N] G1 Z[AZ] F[FD/ 60.0]
N[N] G1 X[AX] Y[AY] Z[AZ] F[F/ 60.0]
$ELSEIF FF + MITTE = 1101
$ELSEIF IN + FFP = 2
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ELSEIF OVL+MITTE+BAHNMITTE = 1
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ELSEIF FFP+FF = 2
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ELSEIF TRC+OVL+OUTNC = 9105
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$LET OUTCIR = 0
$ELSEIF TRC+OUTNC = 9104
N[N] [TC]
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$LET OUTCIR = 0
$ELSEIF TRC+LFP+OUTNC = 9101
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$LET OUTCIR = 0
$ELSEIF HIDE+FF+OVL+IN+OUTNC+MITTE+BAHNMITTE = 0
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ELSEIF HIDE+MITTE = 1100
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ELSEIF HIDE+MITTE+OFFEN = 4101
N[N] G1 X[AX] Y[AY] Z[AZ] F[FC/ 60.0]
$ENDIF
$IF HIDE = 1
$LET HIDE = 0
$ENDIF
$LET OUTNC = 0
$MODAL OFF
$50 Feed CW arc (APS will automatically limit arcs to 180 degrees maximum)
$LET STRECKE_NUTZEN = STRECKE_NUTZEN + (AIA*PI*R/180)
$IF MC = 1
$LET TRC = 4004
$ELSE
$LET TRC = 0
$ENDIF
$IF OUT = 1
$LET OUTNC = 5100
$ENDIF
$IF FF + TRCRAP = 34
N[N] G0 [COMP1] X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ELSEIF FF + BAHNMITTE = 2101
N[N] G0 X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ELSEIF FF + TRCRAP = 1
N[N] G0 [TC] X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ENDIF
$IF TRC + TRCRAP + IN = 34
N[N] G2 X[AX] Y[AY] R[R] F[FC/ 60.0]
$ELSEIF TRC + TRCRAP + IN + FF = 4005
N[N] G2 X[AX] Y[AY] R[R] F[FC/ 60.0]
$ELSEIF TRC + IN + MITTE + BAHNMITTE = 4005
N[N] G2 X[AX] Y[AY] R[R] F[FC/ 60.0]
$ELSEIF FF + MOT = 11
N[N] G1 X[AX] Y[AY] Z[AZ] F[F/ 60.0]
$ELSEIF FF + MITTE = 1101
N[N] G2 X[AX] Y[AY] R[R] F[F/ 60.0]
$ELSEIF TRC + FF + MITTE = 1
N[N] G2 X[AX] Y[AY] R[R] F[F/ 60.0]
$ELSEIF TRC + OUTNC + MITTE + BAHNMITTE = 9104
N[N] G2 X[AX] Y[AY] R[R] F[FC/ 60.0]
$LET OUTCIR = 1
$ELSEIF TRC + OUTNC + TRCRAP = 9104
N[N] G2 X[AX] Y[AY] R[R] F[FC/ 60.0]
$LET OUTCIR = 1
$ELSEIF TRC + OUTNC + TRCRAP = 5133
N[N] G2 X[AX] Y[AY] R[R] F[FC/ 60.0]
$LET OUTCIR = 1
$ELSEIF IN + FFP + MITTE + BAHNMITTE = 2
N[N] G2 X[AX] Y[AY] Z[AZ] R[R] F[F/ 60.0]
$ELSEIF FFP + MITTE + BAHNMITTE = 1
N[N] G2 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ELSEIF OVL + MITTE + BAHNMITTE = 1
N[N] G2 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ELSEIF MITTE + BAHNMITTE = 0
N[N] G2 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ELSEIF MITTE + BAHNMITTE > 0
N[N] G2 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ENDIF
$IF HIDE = 1
$LET HIDE = 0
$ENDIF
$LET OUTNC = 0
$60 Feed CCW arc (APS will automatically limit arcs to 180 degrees maximum)
$LET STRECKE_NUTZEN = STRECKE_NUTZEN + (AIA*PI*R/180)
$IF MC = 1
$LET TRC = 4004
$ELSE
$LET TRC = 0
$ENDIF
$IF OUT = 1
$LET OUTNC = 5100
$ENDIF
$IF FF + TRCRAP = 34
N[N] G0 [COMP1] X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ELSEIF FF + BAHNMITTE = 2101
N[N] G0 X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ELSEIF FF + TRCRAP = 1
N[N] G0 [TC] X[XAPO] Y[YAPO] F500
N[N] G1 Z[AZ] F[FD/ 60.0]
$ENDIF
$IF TRC + TRCRAP + IN = 34
N[N] G3 X[AX] Y[AY] R[R] F[FC/ 60.0]
$ELSEIF TRC + TRCRAP + IN + FF = 4005
N[N] G3 X[AX] Y[AY] R[R] F[FC/ 60.0]
$ELSEIF TRC + IN + MITTE + BAHNMITTE = 4005
N[N] G3 X[AX] Y[AY] R[R] F[FC/ 60.0]
$ELSEIF FF + MOT = 11
N[N] G1 X[AX] Y[AY] Z[AZ] F[F/ 60.0]
$ELSEIF FF + MITTE = 1101
N[N] G3 X[AX] Y[AY] R[R] F[F/ 60.0]
$ELSEIF TRC + FF + MITTE = 1
N[N] G3 X[AX] Y[AY] R[R] F[F/ 60.0]
$ELSEIF TRC + OUTNC + MITTE + BAHNMITTE = 9104
N[N] G3 X[AX] Y[AY] R[R] F[FC/ 60.0]
$LET OUTCIR = 1
$ELSEIF TRC + OUTNC + TRCRAP = 9104
N[N] G3 X[AX] Y[AY] R[R] F[FC/ 60.0]
$LET OUTCIR = 1
$ELSEIF TRC + OUTNC + TRCRAP = 5133
N[N] G3 X[AX] Y[AY] R[R] F[FC/ 60.0]
$LET OUTCIR = 1
$ELSEIF IN + FFP + MITTE + BAHNMITTE = 2
N[N] G3 X[AX] Y[AY] Z[AZ] R[R] F[F/ 60.0]
$ELSEIF FFP + MITTE + BAHNMITTE = 1
N[N] G3 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ELSEIF OVL + MITTE + BAHNMITTE = 1
N[N] G3 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ELSEIF MITTE + BAHNMITTE = 0
N[N] G3 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ELSEIF MITTE + BAHNMITTE > 0
N[N] G3 X[AX] Y[AY] Z[AZ] R[R] F[FC/ 60.0]
$ENDIF
$IF HIDE = 1
$LET HIDE = 0
$ENDIF
$LET OUTNC = 0
$70 Cancel current tool.  Use [T] for current tool number if required.
$75 Code for CLOCKWISE spindle rotation - entered into variable RT
$76 Code for COUNTER-CLOCKWISE spindle rotation - entered into variable RT
$80 Select new tool.  Use [T] for new tool number, [S] for spindle speed.
$90 CALL subroutine. Empty: no subroutines, code is output in full
$100 BEGIN subroutine. Empty: no subroutines
$110 END subroutine. Empty: no subroutines
$120 Origin shift. Empty: shift is applied to coordinates
$130 Cancel origin shift. Empty
$140 Code to CANCEL Machine Tool Compensation
G40
$141 Code for LEFT Machine Tool Compensation
G41
$142 Code for RIGHT Machine Tool Compensation
G42
$145 Percentage increase in blend radius for sharp internal corners
0
$146 Adjust G41/42 code at internal corners for tool radius (1 = Yes 0 = No)
0
$147 Comp can be applied on Rapid Approach (1 = Yes  0 = No)
1
$150 Code to Turn Coolant OFF
$151 Code to apply MIST Coolant
$152 Code to apply FLOOD Coolant
$153 Code to apply THROUGH TOOL Coolant
$200 CANCEL drill/tapping cycle
N[N] G0 Z[ZS] F500
$IF SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
$205 First Hole in SUBROUTINE. NOTE $205/206 apply to ALL drill/peck etc cycles
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
N[N] G0 Z[ZS] F500
N[N] G0 X[AX] Y[AY] F500
N[N] G0 Z[ZR] F500
N[N] G1 Z[ZB] F[F/ 60.0]
$206 Next holes in Subroutine
N[N] G0 Z[ZR] F500
$IF SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
N[N] G0 X[AX] Y[AY] F500
N[N] G1 Z[ZB] F[F/ 60.0]
$210 First Hole
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
N[N] G0 Z[ZS] F500
N[N] G0 X[AX] Y[AY] F500
N[N] G0 Z[ZR] F500
N[N] G1 Z[ZB] F[F/ 60.0]
$211 Next holes
N[N] G0 Z[ZS] F500
$IF SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
N[N] G0 X[AX] Y[AY] F500
N[N] G0 Z[ZR] F500
N[N] G1 Z[ZB] F[F/ 60.0]
$214 First Hole
$IF SHAPE_OPEN = 0
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
$ENDIF
N[N] G0 Z[ZS] F500
N[N] G0 X[AX] Y[AY] F500
N[N] G0 Z[ZR] F500
N[N] G1 Z[ZB] F[F/ 60.0]
$215 Next holes
N[N] G0 Z[ZR] F500
$IF SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
$LET SHAPE_NR = SHAPE_NR + 1
$LET SHAPE_OPEN = 1
N[N] %SHAPE [SHAPE_NR] BEGIN
N[N] G0 X[AX] Y[AY] F500
N[N] G1 Z[ZB] F[F/ 60.0]
$220 First hole
$221 Next holes
$224 First hole
$225 Next holes
$230 First hole
$231 Next holes
$234 First hole
$235 Next holes
$240 First Hole
