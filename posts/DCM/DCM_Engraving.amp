$15 Main Program TRAILING lines
'' Noch offene Kontur schliessen (V1_3)
$IF SHAPE_OPEN = 1
%SHAPE [SHAPE_NR] END
$LET SHAPE_OPEN = 0
$ENDIF
N[N] %
N[N] %***** Postsettings ********************************
N[N] %
'';;; Programmende
'';;[N] .PRGEND
